#!/usr/bin/env bash
# dot - manage dotfiles
#
#   dot status [-a]                          show the state of this machine
#   dot apply [-n] [-y]                      bring this machine in line with its host
#   dot remove <module>[/<part>] [-n] [-y]   undo a module or one of its parts
#   dot uninstall [-n] [-y]                  undo everything dot has done
#
#     -n  dry run, change nothing
#     -y  don't ask for confirmation
#     -a  also show unmanaged packages
#
# Modules: modules/<name>/{packages.txt,links.txt,setup.sh}
# Hosts:   hosts/<hostname>/{modules.txt,packages.txt,links.txt,setup.sh}, fallback hosts/default/
# State:   ~/.local/state/dotfiles/

set -euo pipefail

DOTFILES="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
BACKUP="$STATE/backup/$(date +%Y%m%d-%H%M%S)"
HOST="$(hostnamectl hostname 2>/dev/null || cat /etc/hostname)"
HOST_DIR=""
DRY_RUN=0
ASSUME_YES=0
SHOW_ALL=0
IGNORE_EXCLUDES=0
MODULES=()
declare -A EXCLUDE=()
U_MODULES=() U_LINKS=() U_PKGS=() U_DEPS=() U_PART=""

# ===== output =====

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
item() { printf '   %-9s %s\n' "$1" "$2"; }

# Dry run prints to stderr so it never ends up in captured output
run() {
  if (( DRY_RUN )); then
    printf '   [dry]     %s\n' "$*" >&2
  else
    "$@"
  fi
}

confirm() {
  if (( ASSUME_YES || DRY_RUN )); then return 0; fi
  local answer
  read -r -p "Continue? [y/N] " answer
  [[ "$answer" == [yY]* ]]
}

in_list() {
  local needle="$1" x; shift
  for x in "$@"; do
    if [[ "$x" == "$needle" ]]; then return 0; fi
  done
  return 1
}

# ===== state =====

state_lines() {
  if [[ -f "$STATE/$1" ]]; then cat "$STATE/$1"; fi
}

state_add() {
  local file="$STATE/$1"; shift
  if (( DRY_RUN )); then return 0; fi
  mkdir -p "$STATE"; touch "$file"
  if ! grep -qxF -- "$*" "$file"; then printf '%s\n' "$*" >> "$file"; fi
}

state_del() {
  local file="$STATE/$1"; shift
  if (( DRY_RUN )) || [[ ! -f "$file" ]]; then return 0; fi
  grep -vxF -- "$*" "$file" > "$file.tmp" || true
  mv "$file.tmp" "$file"
}

# Only the first value is kept: it is the state before dot
state_remember() {
  if (( DRY_RUN )); then return 0; fi
  mkdir -p "$STATE"; touch "$STATE/values"
  if ! grep -q "^$1=" "$STATE/values"; then printf '%s=%s\n' "$1" "$2" >> "$STATE/values"; fi
}

state_value() {
  state_lines values | grep -m1 "^$1=" | cut -d= -f2- || true
}

state_link() {
  if (( DRY_RUN )); then return 0; fi
  mkdir -p "$STATE"; touch "$STATE/links"
  awk -F'\t' -v d="$1" '$1 != d' "$STATE/links" > "$STATE/links.tmp"
  printf '%s\t%s\n' "$1" "$2" >> "$STATE/links.tmp"
  mv "$STATE/links.tmp" "$STATE/links"
}

state_unlink() {
  if (( DRY_RUN )) || [[ ! -f "$STATE/links" ]]; then return 0; fi
  awk -F'\t' -v d="$1" '$1 != d' "$STATE/links" > "$STATE/links.tmp"
  mv "$STATE/links.tmp" "$STATE/links"
}

link_source() {
  state_lines links | awk -F'\t' -v d="$1" '$1 == d { print $2 }'
}

# Move a file aside, print where it went
backup() {
  local file="$1" rel="${1#"$HOME"/}"
  run mkdir -p "$BACKUP/$(dirname "$rel")"
  run mv "$file" "$BACKUP/$rel"
  state_add backups "$(printf '%s\t%s' "$file" "$BACKUP/$rel")"
  printf '%s' "$BACKUP/$rel"
}

# Put back the most recent backup of a file
restore_backup() {
  local orig="$1" entry saved
  entry="$(state_lines backups | awk -F'\t' -v o="$orig" '$1 == o' | tail -n1)"
  if [[ -z "$entry" ]]; then return 0; fi
  saved="${entry#*$'\t'}"
  if [[ ! -e "$saved" && ! -L "$saved" ]]; then state_del backups "$entry"; return 0; fi
  if [[ -e "$orig" || -L "$orig" ]]; then warn "not restored, $orig exists: $saved"; return 0; fi
  run mkdir -p "$(dirname "$orig")"
  run mv "$saved" "$orig"
  state_del backups "$entry"
  item restored "$orig"
}

# Remove now-empty parent directories, never leaving $HOME
prune_dirs() {
  local dir="$1"
  if (( DRY_RUN )); then return 0; fi
  while [[ "$dir" == "$HOME"/* ]]; do
    rmdir "$dir" 2>/dev/null || break
    dir="$(dirname "$dir")"
  done
}

# ===== hosts and modules =====

read_list() {
  if [[ ! -f "$1" ]]; then return 0; fi
  sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | grep -v '^$' || true
}

resolve_host() {
  HOST_DIR="$DOTFILES/hosts/$HOST"
  if [[ ! -d "$HOST_DIR" ]]; then
    warn "no host directory for '$HOST', using hosts/default"
    HOST_DIR="$DOTFILES/hosts/default"
  fi
}

# modules.txt: module names; "-part" excludes a part of the module above it
load_modules() {
  local token last=""
  resolve_host
  MODULES=()
  EXCLUDE=()
  while read -r token; do
    if [[ "$token" == -* ]]; then
      if [[ -z "$last" ]]; then die "'$token' in $HOST_DIR/modules.txt does not follow a module"; fi
      EXCLUDE["$last/${token#-}"]=1
    else
      if [[ ! -d "$DOTFILES/modules/$token" ]]; then die "unknown module: $token"; fi
      MODULES+=("$token")
      last="$token"
    fi
  done < <(read_list "$HOST_DIR/modules.txt" | tr -s ' \t' '\n' | grep -v '^$' || true)
  if (( ${#MODULES[@]} == 0 )); then die "no modules in $HOST_DIR/modules.txt"; fi
  MODULES+=(host)
}

# The host directory acts as an extra module named "host"
module_dir() {
  if [[ "$1" == host ]]; then
    printf '%s' "$HOST_DIR"
  else
    printf '%s' "$DOTFILES/modules/$1"
  fi
}

all_modules() {
  find "$DOTFILES/modules" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
  echo host
}

excluded() {
  (( ! IGNORE_EXCLUDES )) && [[ -n "${EXCLUDE[$1/$2]:-}" ]]
}

module_parts() {
  local dir
  dir="$(module_dir "$1")"
  if [[ ! -f "$dir/setup.sh" ]]; then return 0; fi
  (
    MODULE_DIR="$dir"
    PARTS=()
    source "$dir/setup.sh"
    if (( ${#PARTS[@]} )); then printf '%s\n' "${PARTS[@]}"; fi
  )
}

# Packages of a module, or only those of one part
module_packages() {
  local m="$1" part="${2:-}" p
  while read -r p; do
    if [[ -n "$part" ]]; then
      if [[ "$p" == "$part" ]]; then echo "$p"; fi
    elif ! excluded "$m" "$p"; then
      echo "$p"
    fi
  done < <(read_list "$(module_dir "$m")/packages.txt")
}

packages_of() {
  local m
  for m in "$@"; do module_packages "$m"; done | sort -u
}

# "source<TAB>target" per link; a link belongs to the part named by its first path segment
module_links() {
  local m="$1" part="${2:-}" dir src dst first real
  dir="$(module_dir "$m")"
  while read -r src dst; do
    first="${src%%/*}"
    if [[ -n "$part" ]]; then
      if [[ "$first" != "$part" ]]; then continue; fi
    elif excluded "$m" "$first"; then
      continue
    fi
    real="$dir/${src//\{host\}/$HOST}"
    if [[ "$src" == *"{host}"* && ! -e "$real" ]]; then
      real="$dir/${src//\{host\}/default}"
    fi
    printf '%s\t%s\n' "$(realpath -m "$real")" "${dst/#\~/$HOME}"
  done < <(read_list "$dir/links.txt")
}

check_conflicts() {
  local dups m
  dups="$(for m in "${MODULES[@]}"; do module_links "$m"; done | cut -f2 | sort | uniq -d)"
  if [[ -n "$dups" ]]; then
    die "target listed more than once (duplicate line or two modules want the same file):"$'\n'"$dups"
  fi
}

check_excludes() {
  local key m p
  for key in "${!EXCLUDE[@]}"; do
    m="${key%%/*}"; p="${key#*/}"
    if [[ -z "$(module_packages "$m" "$p")$(module_links "$m" "$p")" ]] \
       && ! module_parts "$m" | grep -qx -- "$p"; then
      warn "'-$p' matches nothing in module $m"
    fi
  done
}

# ok | new | replace | backup | missing
link_state() {
  local src="$1" dst="$2" current
  if [[ ! -e "$src" ]]; then echo missing; return; fi
  if [[ -L "$dst" ]]; then
    current="$(readlink "$dst")"
    if [[ "$current" == "$src" ]]; then echo ok; return; fi
    if [[ "$current" == "$DOTFILES"/* ]]; then echo replace; return; fi
    echo backup; return
  fi
  if [[ -e "$dst" ]]; then echo backup; return; fi
  echo new
}

# setup/teardown in a subshell so modules can't clash. With PARTS, call
# <hook>_<part> per part (teardown in reverse order), skipping excluded parts.
run_hook() {
  local m="$1" hook="$2" part="${3:-}" dir
  dir="$(module_dir "$m")"
  if [[ ! -f "$dir/setup.sh" ]]; then return 0; fi
  (
    MODULE_DIR="$dir"
    PARTS=()
    source "$dir/setup.sh"
    if (( ${#PARTS[@]} == 0 )); then
      if [[ -z "$part" ]] && declare -F "$hook" >/dev/null; then "$hook"; fi
      exit 0
    fi
    order=()
    for (( i = 0; i < ${#PARTS[@]}; i++ )); do
      if [[ "$hook" == teardown ]]; then
        order+=("${PARTS[${#PARTS[@]} - 1 - i]}")
      else
        order+=("${PARTS[i]}")
      fi
    done
    for p in "${order[@]}"; do
      if [[ -n "$part" && "$p" != "$part" ]]; then continue; fi
      if [[ -z "$part" ]] && excluded "$m" "$p"; then continue; fi
      if declare -F "${hook}_$p" >/dev/null; then "${hook}_$p"; fi
    done
  )
}

checks() {
  if (( EUID == 0 )); then die "do not run as root, sudo is called when needed"; fi
  if ! command -v pacman >/dev/null; then die "dot requires Arch Linux (pacman)"; fi
}

# ===== status =====

cmd_status() {
  load_modules
  check_conflicts
  check_excludes
  local m src dst st n_ok=0 pkgs=() missing=() extra=() orphans=()

  info "Host: $HOST ($(basename "$HOST_DIR"))"
  item modules "${MODULES[*]}"
  if (( ${#EXCLUDE[@]} )); then
    while read -r m; do item excluded "$m"; done < <(printf '%s\n' "${!EXCLUDE[@]}" | sort)
  fi

  info "Packages"
  mapfile -t pkgs < <(packages_of "${MODULES[@]}")
  if (( ${#pkgs[@]} )); then mapfile -t missing < <(pacman -T "${pkgs[@]}" || true); fi
  if (( ${#missing[@]} )); then
    for m in "${missing[@]}"; do item missing "$m"; done
  else
    item ok "all ${#pkgs[@]} installed"
  fi

  info "Links"
  for m in "${MODULES[@]}"; do
    while IFS=$'\t' read -r src dst; do
      st="$(link_state "$src" "$dst")"
      if [[ "$st" == ok ]]; then (( ++n_ok )); else item "$st" "$dst"; fi
    done < <(module_links "$m")
  done
  item ok "$n_ok correct"

  info "Installed by dot, but in no active module"
  mapfile -t orphans < <(comm -23 <(state_lines packages | sort -u) <(printf '%s\n' "${pkgs[@]}"))
  if (( ${#orphans[@]} )); then item remove "${orphans[*]}"; else item ok "none"; fi

  if (( SHOW_ALL )); then
    info "Explicitly installed, but in no module (repo packages only)"
    mapfile -t extra < <(comm -23 <(pacman -Qqen | sort) <(printf '%s\n' "${pkgs[@]}"))
    if (( ${#extra[@]} )); then
      printf '%s\n' "${extra[*]}" | fold -s -w 76 | sed 's/^/   /'
    else
      item ok "none"
    fi
  fi
}

# ===== apply =====

cmd_apply() {
  checks
  load_modules
  check_conflicts
  check_excludes

  local m p i src dst st n_ok=0
  local all=() missing=() asdeps=() l_src=() l_dst=() l_state=()

  mapfile -t all < <(packages_of "${MODULES[@]}")
  if (( ${#all[@]} )); then
    mapfile -t missing < <(pacman -T "${all[@]}" || true)
    mapfile -t asdeps  < <(pacman -Qqd "${all[@]}" 2>/dev/null || true)
  fi

  for m in "${MODULES[@]}"; do
    while IFS=$'\t' read -r src dst; do
      st="$(link_state "$src" "$dst")"
      if [[ "$st" == ok ]]; then (( ++n_ok )); continue; fi
      l_src+=("$src"); l_dst+=("$dst"); l_state+=("$st")
    done < <(module_links "$m")
  done

  info "Plan for $HOST (modules: ${MODULES[*]})"
  if (( ${#missing[@]} )); then item install "${missing[*]}"; fi
  if (( ${#asdeps[@]} ));  then item explicit "${asdeps[*]}"; fi
  for i in "${!l_dst[@]}"; do item "${l_state[i]}" "${l_dst[i]}"; done
  item ok "$n_ok links already correct"
  for m in "${MODULES[@]}"; do
    ( DRY_RUN=1; run_hook "$m" setup ) 2>&1 | sed 's/^/  /'
  done

  if ! confirm; then info "Aborted."; return 0; fi
  if (( DRY_RUN )); then info "DRY RUN: nothing will be changed"; fi

  if (( ${#missing[@]} )); then
    info "Packages"
    run sudo pacman -S --needed "${missing[@]}"
    for p in "${missing[@]}"; do state_add packages "$p"; done
  fi
  if (( ${#asdeps[@]} )); then
    run sudo pacman -D --asexplicit "${asdeps[@]}"
    for p in "${asdeps[@]}"; do state_add explicit "$p"; done
  fi

  if (( ${#l_dst[@]} )); then
    info "Links"
    for i in "${!l_dst[@]}"; do
      src="${l_src[i]}"; dst="${l_dst[i]}"
      case "${l_state[i]}" in
        missing) warn "source missing, skipped: $src"; continue ;;
        backup)  backup "$dst" >/dev/null ;;
      esac
      run mkdir -p "$(dirname "$dst")"
      run ln -sfn "$src" "$dst"
      state_link "$dst" "$src"
      item "${l_state[i]}" "$dst"
    done
  fi

  for m in "${MODULES[@]}"; do run_hook "$m" setup; done

  info "Done."
  if [[ -d "$BACKUP" ]]; then info "Backups: $BACKUP"; fi
}

# ===== remove / uninstall =====

# Undo U_MODULES (teardown, limited to U_PART if set), U_LINKS,
# U_PKGS (remove), U_DEPS (back to dependency)
undo() {
  local m dst src p
  info "Plan"
  for m in "${U_MODULES[@]}"; do
    ( DRY_RUN=1; run_hook "$m" teardown "$U_PART" ) 2>&1 | sed 's/^/  /'
  done
  for dst in "${U_LINKS[@]}"; do item unlink "$dst"; done
  if (( ${#U_PKGS[@]} )); then item remove "${U_PKGS[*]}"; fi
  if (( ${#U_DEPS[@]} )); then item demote "${U_DEPS[*]}"; fi

  if ! confirm; then info "Aborted."; return 1; fi
  if (( DRY_RUN )); then info "DRY RUN: nothing will be changed"; fi

  for m in "${U_MODULES[@]}"; do run_hook "$m" teardown "$U_PART"; done

  if (( ${#U_LINKS[@]} )); then
    info "Links"
    for dst in "${U_LINKS[@]}"; do
      src="$(link_source "$dst")"
      if [[ -L "$dst" && "$(readlink "$dst")" == "$src" ]]; then
        run rm "$dst"
        item removed "$dst"
      fi
      state_unlink "$dst"
      restore_backup "$dst"
      prune_dirs "$(dirname "$dst")"
    done
  fi

  if (( ${#U_PKGS[@]} )); then
    info "Packages"
    run sudo pacman -Rnsu "${U_PKGS[@]}" || warn "pacman reported an error"
    if (( ! DRY_RUN )); then
      for p in "${U_PKGS[@]}"; do
        if pacman -Qq "$p" >/dev/null 2>&1; then
          warn "kept, required by other packages: $p"
        else
          state_del packages "$p"
        fi
      done
    fi
  fi
  if (( ${#U_DEPS[@]} )); then
    run sudo pacman -D --asdeps "${U_DEPS[@]}"
    for p in "${U_DEPS[@]}"; do state_del explicit "$p"; done
  fi
}

cmd_remove() {
  local target="${1:-}" mod part="" m src dst keep own
  checks
  if [[ -z "$target" ]]; then die "usage: dot remove <module>[/<part>]"; fi
  mod="${target%%/*}"
  if [[ "$target" == */* ]]; then part="${target#*/}"; fi
  if [[ ! -d "$DOTFILES/modules/$mod" ]]; then die "unknown module: $mod"; fi
  load_modules

  if in_list "$mod" "${MODULES[@]}"; then
    if [[ -z "$part" ]]; then
      warn "'$mod' is still listed in $HOST_DIR/modules.txt, the next apply will bring it back"
    elif ! excluded "$mod" "$part"; then
      warn "add '-$part' under '$mod' in $HOST_DIR/modules.txt, or the next apply will bring it back"
    fi
  fi

  # Packages still needed by everything else that stays active
  keep="$(for m in "${MODULES[@]}"; do
            if [[ "$m" != "$mod" ]]; then
              module_packages "$m"
            elif [[ -n "$part" ]]; then
              module_packages "$m" | grep -vx -- "$part" || true
            fi
          done | sort -u)"

  # From here on, remove what dot did regardless of current excludes
  IGNORE_EXCLUDES=1
  own="$(module_packages "$mod" "$part" | sort -u)"
  mapfile -t U_PKGS < <(comm -12 <(printf '%s\n' "$own") <(state_lines packages | sort -u) \
                        | comm -23 - <(printf '%s\n' "$keep") | grep -v '^$' || true)
  mapfile -t U_DEPS < <(comm -12 <(printf '%s\n' "$own") <(state_lines explicit | sort -u) \
                        | comm -23 - <(printf '%s\n' "$keep") | grep -v '^$' || true)

  U_LINKS=()
  while IFS=$'\t' read -r src dst; do
    if [[ -n "$(link_source "$dst")" ]]; then U_LINKS+=("$dst"); fi
  done < <(module_links "$mod" "$part")

  U_MODULES=("$mod")
  U_PART="$part"
  undo || true
}

cmd_uninstall() {
  local entry
  checks
  resolve_host
  IGNORE_EXCLUDES=1
  mapfile -t U_MODULES < <(all_modules)
  mapfile -t U_LINKS   < <(state_lines links | cut -f1)
  mapfile -t U_PKGS    < <(state_lines packages | sort -u)
  mapfile -t U_DEPS    < <(state_lines explicit | sort -u)

  warn "this undoes everything dot has set up on this machine"
  if ! undo; then return 0; fi

  info "Remaining backups"
  while IFS= read -r entry; do
    restore_backup "${entry%%$'\t'*}"
  done < <(state_lines backups)

  run rm -rf "$STATE"
  info "Done. The repo is still at $DOTFILES"
}

usage() {
  sed -n '2,15p' "$DOTFILES/dot" | sed 's/^# \{0,1\}//'
}

# ===== main =====

main() {
  local cmd="${1:-status}" args=() a
  if (( $# )); then shift; fi
  for a in "$@"; do
    case "$a" in
      -n) DRY_RUN=1 ;;
      -y) ASSUME_YES=1 ;;
      -ny|-yn) DRY_RUN=1; ASSUME_YES=1 ;;
      -a) SHOW_ALL=1 ;;
      -*) die "unknown option: $a" ;;
      *)  args+=("$a") ;;
    esac
  done
  case "$cmd" in
    status)         cmd_status ;;
    apply)          cmd_apply ;;
    remove)         cmd_remove "${args[@]:-}" ;;
    uninstall)      cmd_uninstall ;;
    help|-h|--help) usage ;;
    *)              usage; exit 1 ;;
  esac
}

main "$@"
