#!/usr/bin/env bash
# dot – dotfiles verwalten
#
#   dot status           Zustand dieses Rechners anzeigen
#   dot apply [-n] [-y]  Rechner auf den Stand seiner Module bringen
#                          -n  Probelauf: nur anzeigen, nichts ändern
#                          -y  ohne Rückfrage
#
# Module: modules/<name>/  (packages.txt, links.txt, setup.sh)
# Hosts:  hosts/<hostname>.txt  (Liste der Module, sonst default.txt)
# Gedächtnis: ~/.local/state/dotfiles/

set -euo pipefail

DOTFILES="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
BACKUP="$STATE/backup/$(date +%Y%m%d-%H%M%S)"
HOST="$(hostnamectl hostname 2>/dev/null || cat /etc/hostname)"
DRY_RUN=0
ASSUME_YES=0
MODULES=()

# ===================== Ausgabe =====================

info() { printf '\033[1;34m::\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
item() { printf '   %-9s %s\n' "$1" "$2"; }

# Befehl ausführen, im Probelauf nur anzeigen (auf stderr, damit
# Rückgabewerte von Funktionen nicht verfälscht werden)
run() {
  if (( DRY_RUN )); then
    printf '   [probe]   %s\n' "$*" >&2
  else
    "$@"
  fi
}

confirm() {
  if (( ASSUME_YES || DRY_RUN )); then
    return 0
  fi
  local answer
  read -r -p "Fortfahren? [j/N] " answer
  [[ "$answer" == [jJyY]* ]]
}

# ===================== Gedächtnis =====================

# Zeile in eine Zustandsdatei aufnehmen (doppelte werden ignoriert)
state_add() {
  local file="$STATE/$1"; shift
  if (( DRY_RUN )); then return 0; fi
  mkdir -p "$STATE"; touch "$file"
  if ! grep -qxF -- "$*" "$file"; then
    printf '%s\n' "$*" >> "$file"
  fi
}

# Einen Wert nur beim ersten Mal merken (den Zustand vor dot)
state_remember() {
  if (( DRY_RUN )); then return 0; fi
  mkdir -p "$STATE"; touch "$STATE/values"
  if ! grep -q "^$1=" "$STATE/values"; then
    printf '%s=%s\n' "$1" "$2" >> "$STATE/values"
  fi
}

# Link merken: Ziel, Quelle, Sicherung (eine frühere Sicherung bleibt erhalten)
state_link() {
  if (( DRY_RUN )); then return 0; fi
  mkdir -p "$STATE"; touch "$STATE/links"
  local dst="$1" src="$2" saved="$3" old
  old="$(awk -F'\t' -v d="$dst" '$1 == d { print $3 }' "$STATE/links")"
  if [[ "$saved" == "-" && -n "$old" ]]; then
    saved="$old"
  fi
  awk -F'\t' -v d="$dst" '$1 != d' "$STATE/links" > "$STATE/links.tmp"
  printf '%s\t%s\t%s\n' "$dst" "$src" "$saved" >> "$STATE/links.tmp"
  mv "$STATE/links.tmp" "$STATE/links"
}

# Datei beiseiteräumen, gibt den Ort der Sicherung aus
backup() {
  local file="$1" rel="${1#"$HOME"/}"
  run mkdir -p "$BACKUP/$(dirname "$rel")"
  run mv "$file" "$BACKUP/$rel"
  state_add backups "$(printf '%s\t%s' "$file" "$BACKUP/$rel")"
  printf '%s' "$BACKUP/$rel"
}

# ===================== Module lesen =====================

# Zeilen einer Liste ohne Kommentare und Leerzeilen
read_list() {
  if [[ ! -f "$1" ]]; then return 0; fi
  sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$1" | grep -v '^$' || true
}

load_modules() {
  local file="$DOTFILES/hosts/$HOST.txt" m
  if [[ ! -f "$file" ]]; then
    warn "Keine Host-Datei für '$HOST', verwende default.txt"
    file="$DOTFILES/hosts/default.txt"
  fi
  mapfile -t MODULES < <(read_list "$file" | tr -s ' \t' '\n' | grep -v '^$' || true)
  if (( ${#MODULES[@]} == 0 )); then die "Keine Module in $file"; fi
  for m in "${MODULES[@]}"; do
    if [[ ! -d "$DOTFILES/modules/$m" ]]; then die "Modul nicht gefunden: $m"; fi
  done
}

# Alle Pakete der aktiven Module, sortiert und ohne doppelte
all_packages() {
  local m
  for m in "${MODULES[@]}"; do
    read_list "$DOTFILES/modules/$m/packages.txt"
  done | sort -u
}

# Links eines Moduls als "quelle<TAB>ziel"
module_links() {
  local m="$1" src dst real
  while read -r src dst; do
    real="$DOTFILES/modules/$m/${src//\{host\}/$HOST}"
    if [[ "$src" == *"{host}"* && ! -e "$real" ]]; then
      real="$DOTFILES/modules/$m/${src//\{host\}/default}"
    fi
    printf '%s\t%s\n' "$(realpath -m "$real")" "${dst/#\~/$HOME}"
  done < <(read_list "$DOTFILES/modules/$m/links.txt")
}

# Jedes Ziel darf nur einmal vorkommen
check_conflicts() {
  local dups
  dups="$(for m in "${MODULES[@]}"; do module_links "$m"; done | cut -f2 | sort | uniq -d)"
  if [[ -n "$dups" ]]; then
    die "Ziel mehrfach in den Link-Listen (doppelte Zeile oder zwei Module wollen dieselbe Datei):"$'\n'"$dups"
  fi
}

# Zustand eines Links: ok | neu | ersetzen | sichern | fehlt
link_state() {
  local src="$1" dst="$2" current
  if [[ ! -e "$src" ]]; then echo fehlt; return; fi
  if [[ -L "$dst" ]]; then
    current="$(readlink "$dst")"
    if [[ "$current" == "$src" ]]; then echo ok; return; fi
    if [[ "$current" == "$DOTFILES"/* ]]; then echo ersetzen; return; fi  # alter eigener Link
    echo sichern; return
  fi
  if [[ -e "$dst" ]]; then echo sichern; return; fi
  echo neu
}

checks() {
  if (( EUID == 0 )); then die "Bitte nicht als root ausführen. sudo wird bei Bedarf selbst aufgerufen."; fi
  if ! command -v pacman >/dev/null; then die "dot ist für Arch Linux (pacman)."; fi
}

# ===================== Befehle =====================

cmd_status() {
  load_modules
  check_conflicts
  local m src dst st n_ok=0 pkgs=() missing=() extra=()

  info "Rechner: $HOST"
  item module "${MODULES[*]}"

  info "Pakete"
  mapfile -t pkgs < <(all_packages)
  if (( ${#pkgs[@]} )); then
    mapfile -t missing < <(pacman -T "${pkgs[@]}" || true)
  fi
  if (( ${#missing[@]} )); then
    for m in "${missing[@]}"; do item fehlt "$m"; done
  else
    item ok "alle ${#pkgs[@]} installiert"
  fi

  info "Links"
  for m in "${MODULES[@]}"; do
    while IFS=$'\t' read -r src dst; do
      st="$(link_state "$src" "$dst")"
      if [[ "$st" == ok ]]; then (( ++n_ok )); else item "$st" "$dst"; fi
    done < <(module_links "$m")
  done
  item ok "$n_ok richtig"

  info "Ausdrücklich installiert, aber in keinem Modul (nur Repo-Pakete)"
  mapfile -t extra < <(comm -23 <(pacman -Qqen | sort) <(printf '%s\n' "${pkgs[@]}" | sort))
  if (( ${#extra[@]} )); then
    printf '   %s\n' "${extra[*]}" | fold -s -w 78 | sed 's/^/   /'
  else
    item ok "keine"
  fi
}

cmd_apply() {
  checks
  load_modules
  check_conflicts

  local m p i src dst st saved n_ok=0
  local all=() missing=() asdeps=()
  local l_src=() l_dst=() l_state=()

  # ----- Plan: Pakete -----
  mapfile -t all < <(all_packages)
  if (( ${#all[@]} )); then
    mapfile -t missing < <(pacman -T "${all[@]}" || true)
    mapfile -t asdeps  < <(pacman -Qqd "${all[@]}" 2>/dev/null || true)
  fi

  # ----- Plan: Links -----
  for m in "${MODULES[@]}"; do
    while IFS=$'\t' read -r src dst; do
      st="$(link_state "$src" "$dst")"
      if [[ "$st" == ok ]]; then (( ++n_ok )); continue; fi
      l_src+=("$src"); l_dst+=("$dst"); l_state+=("$st")
    done < <(module_links "$m")
  done

  # ----- Übersicht -----
  info "Plan für $HOST (Module: ${MODULES[*]})"
  if (( ${#missing[@]} )); then item paket "installieren: ${missing[*]}"; fi
  if (( ${#asdeps[@]} ));  then item paket "als ausdrücklich markieren: ${asdeps[*]}"; fi
  for i in "${!l_dst[@]}"; do item "${l_state[i]}" "${l_dst[i]}"; done
  item ok "$n_ok Links bereits richtig"
  item setup "Einrichtung der Module"

  if ! confirm; then info "Abgebrochen."; return 0; fi
  if (( DRY_RUN )); then info "PROBELAUF: es wird nichts verändert"; fi

  # ----- Pakete -----
  if (( ${#missing[@]} )); then
    info "Pakete installieren"
    run sudo pacman -S --needed "${missing[@]}"
    for p in "${missing[@]}"; do state_add packages "$p"; done
  fi
  if (( ${#asdeps[@]} )); then
    run sudo pacman -D --asexplicit "${asdeps[@]}"
    for p in "${asdeps[@]}"; do state_add explicit "$p"; done
  fi

  # ----- Links -----
  if (( ${#l_dst[@]} )); then
    info "Links"
    for i in "${!l_dst[@]}"; do
      src="${l_src[i]}"; dst="${l_dst[i]}"; saved="-"
      case "${l_state[i]}" in
        fehlt)   warn "Quelle fehlt, übersprungen: $src"; continue ;;
        sichern) saved="$(backup "$dst")" ;;
      esac
      run mkdir -p "$(dirname "$dst")"
      run ln -sfn "$src" "$dst"
      state_link "$dst" "$src" "$saved"
      item "${l_state[i]}" "$dst"
    done
  fi

  # ----- Einrichtung -----
  for m in "${MODULES[@]}"; do
    if [[ -f "$DOTFILES/modules/$m/setup.sh" ]]; then
      (
        MODULE_DIR="$DOTFILES/modules/$m"
        source "$MODULE_DIR/setup.sh"
        if declare -F setup >/dev/null; then setup; fi
      )
    fi
  done

  info "Fertig."
  if [[ -d "$BACKUP" ]]; then info "Gesichert wurde nach: $BACKUP"; fi
}

usage() {
  sed -n '2,13p' "$DOTFILES/dot" | sed 's/^# \{0,1\}//'
}

# ===================== Ablauf =====================

main() {
  local cmd="${1:-status}"
  if (( $# )); then shift; fi
  local opt
  while getopts ":ny" opt; do
    case "$opt" in
      n) DRY_RUN=1 ;;
      y) ASSUME_YES=1 ;;
      *) die "Unbekannte Option: -$OPTARG" ;;
    esac
  done
  case "$cmd" in
    status) cmd_status ;;
    apply)  cmd_apply ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
