#!/usr/bin/env bash
# Einstiegspunkt für matugen: hängt ansi.json und fonts.json an,
# merkt sich das Schema für ansi-tune und setzt die GTK-Schriften.
#
# Aufruf wie matugen selbst, z.B.:
#   theme-apply image ~/Pictures/Wallpapers/x.png -m dark -t scheme-vibrant

set -euo pipefail

STATE="$HOME/.local/state/theme"
SETTINGS="$HOME/.config/matugen/ansi.json"
FONTS="$HOME/.config/matugen/fonts.json"

# Schema (-t <name>) aus den Argumenten merken
args=("$@")
for ((i = 0; i < ${#args[@]} - 1; i++)); do
  if [[ "${args[i]}" == "-t" ]]; then
    mkdir -p "$STATE"
    printf '%s\n' "${args[i+1]}" > "$STATE/scheme"
  fi
done

matugen "$@" --import-json "$SETTINGS" --import-json "$FONTS"

# GTK-Schriften (gsettings), nur setzen, wenn sie sich unterscheiden
gset() {
  local key="$1" value="$2"
  if [[ "$(gsettings get org.gnome.desktop.interface "$key" 2>/dev/null)" != "'$value'" ]]; then
    gsettings set org.gnome.desktop.interface "$key" "$value" || true
  fi
}
if command -v gsettings >/dev/null; then
  size=$(jq -r '.fonts.size.ui' "$FONTS")
  gset font-name           "$(jq -r '.fonts.family.sans' "$FONTS") $size"
  gset monospace-font-name "$(jq -r '.fonts.family.mono' "$FONTS") $size"
fi
